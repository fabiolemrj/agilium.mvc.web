@page
@model LoginModel
@{
    Layout = null;

}
@{
    ViewData["Title"] = "Log in";
}

<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Agilium Painel</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/dist/plugins/fontawesome-free/css/all.min.css">
    <!-- overlayScrollbars -->
    <link rel="stylesheet" href="~/dist/plugins/overlayScrollbars/js/jquery.overlayScrollbars.js">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <link rel="stylesheet" href="~/css/site.css">

</head>

<body class="hold-transition login-page">
    <div class="login-box">
        <div class="login-logo">
            <a href="#">Agilium Painel</a>
        </div>
        <!-- /.login-logo -->
        <div class="card card-login-agilium">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Faça login para iniciar sua sessão</p>

                <form id="account" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="input-group mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="Usuario" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                        <div class="input-group-text">
                            <span asp-validation-for="Input.Email" class="fas fa-envelope text-danger"></span>
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="Senha" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <div class="input-group-text">
                            <span asp-validation-for="Input.Password" class="fas fa-lock text-danger"></span>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        <select class="form-control" asp-for="Input.Empresa"
                                asp-items="@Model.Empresas.Select(x => new SelectListItem(){Text = x.NMRZSOCIAL, Value = x.Id.ToString()})">
                            <option value="" disabled selected>** Selecionar Empresa **</option>
                        </select>
                        <div class="input-group-text">
                            <span asp-validation-for="Input.Empresa" class="fa fa-building text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-5">
                            <div class="icheck-primary">
                                <input type="checkbox" id="remember">
                                <label for="remember">
                                    Lembre-me
                                </label>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-7">
                            <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                        </div>
                        <!-- /.col -->
                    </div>
                </form>

                <!-- /.social-auth-links -->

                <p class="mb-1">
                    <a id="forgot-password" asp-page="./ForgotPassword">Esqueceu a senha?</a>
                </p>
               @*  <p class="mb-0">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registre uma nova assinatura</a>
                </p> *@
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>

    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="~/dist/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <!-- AdminLTE App -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- jQuery -->
    <script src="~/dist/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/dist/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/dist/js/adminlte.min.js"></script>
    <script src="~/dist/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>


</body>
</html>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
