@using agilum.mvc.web.ViewModels.PlanoConta
@model agilum.mvc.web.ViewModels.PagedViewModel<PlanoContaViewModel>
@using agilum.mvc.web.Extensions

@{
    ViewData["Title"] = "Planos de Contas";
}
<h5>@ViewData["Title"]</h5>
<hr />
<section class="barra-de-menu-principal">
    <div class="barra-de-botoes-menu-principal">
        <a asp-action="CreatePlanoConta" onclick="on()" title="Cadastrar Novo Registro"><span class="fa fa-plus-square sns-tool-action" id="btnNovoCadastro"></span></a>
        <a href="#" title="Voltar" id="btnVoltar"> <span class="fas fa-reply sns-tool-action"></span> </a>
        <a href="#" title="Precisa de Ajuda?" id="btnAjuda"><span class="fa fa-question sns-tool-action"></span></a>

    </div>

    <article>
        <div class="barra-de-posicao-atual" id="breadcrumb">
            <a asp-action="Index" asp-controller="Home"> Início</a> /
            <a href="#"><i class="fa fa-dashboard"></i> Plano de Conta </a>
        </div>
    </article>
</section>
<br />
<div class="row">
    <div class="col-12" id="areaFiltro">
        <form asp-action="Index" class="sidebar-form" method="get">
            <input type="hidden" asp-for="PageSize" id="PageSize" />
            <input type="hidden" asp-for="PageIndex" id="PageIndex" />

            <div class="row mb-2">
                <!-- Campo de pesquisa -->
                <div class="col-lg-4 col-md-4 col-sm-12 mb-2">
                    <input value="@ViewBag.Pesquisa"
                           class="form-control"
                           title="Pesquisar por descrição"
                           placeholder="Pesquisar por descrição..."
                           id="q" name="q" />
                </div>

                <!-- Campo Natureza -->
                <div class="col-lg-4 col-md-4 col-sm-12 mb-2">
                    <select class="form-control" id="tipoLancamento" name="tipoLancamento">
                        <option value="">-- Selecione --</option>
                        @if (ViewBag.TipoLancamento == "D")
                        {
                            <option value="D" selected>Débito</option>
                            <option value="C">Crédito</option>
                        }
                        else if (ViewBag.TipoLancamento == "C")
                        {
                            <option value="D">Débito</option>
                            <option value="C" selected>Crédito</option>
                        }
                        else
                        {
                            <option value="D">Débito</option>
                            <option value="C">Crédito</option>
                        }
                    </select>
                </div>

                <!-- Botão de submit -->
                <div class="">
                    <button type="submit" class="btn btn-info btn-flat w-100" title="Pesquisar">
                        <i class="fa fa-search"></i> Pesquisar
                    </button>
                </div>
            </div>

            <!-- Botão escondido para compatibilidade com scripts existentes -->
            <button class="btn" id="btnSendForm" type="submit" style="visibility:hidden"></button>
        </form>


    </div>
</div>
<div id="divGridResultado">
    <table class="table table-hover">
        <thead class="table thead-dark">
            <tr>
                <th>
                    Conta
                </th>
                <th>
                    Descrição
                </th>
                <th>
                    Saldo
                </th>
                <th>
                    Natureza
                </th>

                <th>
                    Situação
                </th>
                <th class=""></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List)
            {
                var ativo = "";
                var classeAtivo = "";
                if (item.Situacao == agilium.api.business.Enums.EAtivo .Ativo)
                {
                    ativo = "Ativo";
                    classeAtivo = "btn btn-danger";
                }
                else
                {
                    ativo = "Inativo";
                    classeAtivo = "btn btn-success";
                }

                var saldo = item.Saldo;
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Codigo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                    <td>
                        @Html.Raw(saldo.ToString("C"))
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tipo)
                    </td>
                    <td>
                        @if (item.Situacao == agilium.api.business.Enums.EAtivo.Ativo)
                        {
                            <span class="text-success">Ativo</span>
                        }
                        else
                        {
                            <span class="text-danger">Inativo</span>
                        }
                    </td>
                    <td class="text-right">
                        <a class="btn btn-info load__tela" asp-action="IndexLancamentos" asp-route-idConta="@item.Id" title="Lançamentos"><spam class="fas fa-tasks"></spam></a>
                        <a class="btn btn-default" asp-action="AtualizarSaldoPorId" asp-route-id="@item.Id" title="Atualizar Saldo"><spam class="fas fa-sync-alt"></spam></a>
                        <a class="btn btn-warning" asp-action="EditPlanoConta" asp-route-id="@item.Id" title="Editar"><spam class="fa fa-pencil-alt"></spam></a>
                        <a class="btn btn-danger" asp-action="DeletePlanoConta" asp-route-id="@item.Id" title="Apagar"><spam class="fa fa-trash"></spam></a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>

                <td colspan="6">
                    <nav>
                        <ul class="pagination justify-content-center">
                            @{
                                int maxPagesToShow = 10;
                                int totalPages = (int)Model.TotalPages;
                                int pageIndex = (int)Model.PageIndex;

                                int half = maxPagesToShow / 2;
                                int startPage = Math.Max(1, pageIndex - half);
                                int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                                // Corrige quando o range não completa 5 páginas
                                if (endPage - startPage + 1 < maxPagesToShow)
                                {
                                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                }

                                // Botão "Anterior"
                                if (pageIndex > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@(pageIndex - 1)" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-tipoLancamento="@ViewBag.TipoLancamento">Anterior</a>
                                    </li>
                                }

                                // Primeira página + "..."
                                if (startPage > 1)
                                {
                                    <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="1" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-tipoLancamento="@ViewBag.TipoLancamento">1</a></li>
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }

                                // Loop limitado
                                for (int i = startPage; i <= endPage; i++)
                                {
                                    if (i == pageIndex)
                                    {
                                        <li class="page-item active"><span class="page-link">@i</span></li>
                                    }
                                    else
                                    {
                                        <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@i" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-tipoLancamento="@ViewBag.TipoLancamento">@i</a></li>
                                    }
                                }

                                // Última página + "..."
                                if (endPage < totalPages)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@totalPages" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-tipoLancamento="@ViewBag.TipoLancamento">@totalPages</a></li>
                                }

                                // Botão "Próximo"
                                if (pageIndex < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@(pageIndex + 1)" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-tipoLancamento="@ViewBag.TipoLancamento">Próximo</a>
                                    </li>
                                }
                            }
                        </ul>
                    </nav>
                </td>
            </tr>

        </tfoot>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/local/Financeiro/planoConta.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>

}