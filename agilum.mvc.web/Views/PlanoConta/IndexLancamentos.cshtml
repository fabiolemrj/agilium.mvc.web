@using agilum.mvc.web.ViewModels.PlanoConta
@model agilum.mvc.web.ViewModels.PagedViewModel<PlanoContaLancamentoViewModel>
@using agilum.mvc.web.Extensions
@using agilum.mvc.web.Enums

@{
    ViewData["Title"] = "Planos de Contas - Lançamentos";
}

<h5>@ViewData["Title"]</h5>
<hr />

<section class="barra-de-menu-principal">
    <div class="barra-de-botoes-menu-principal">
        <a href="javascript:history.go(-1)" title="Voltar"><span class="fas fa-reply sns-tool-action"></span></a>
        <a href="#" title="Precisa de Ajuda?"><span class="fa fa-question sns-tool-action"></span></a>
    </div>
    <article>
        <div class="barra-de-posicao-atual" id="breadcrumb">
            <a asp-action="Index" asp-controller="Home">Início</a> /
            <a href="@Url.Action("Index","PlanoConta")"><i class="fa fa-dashboard"></i> Plano de Conta</a> /
            <span>Lançamentos</span>
        </div>
    </article>
</section>

<br />

<div class="row">
    <div class="col-lg-4 col-6">
        <div class="small-box bg-info disabled color-palette">
            <div class="inner">
                <h3>@ViewBag.Saldo.ToString("N")<sup style="font-size: 20px">$</sup></h3>
                <p>@ViewBag.Conta</p>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
            <span class="small-box-footer">Saldo</span>
        </div>
    </div>
</div>

<!-- Formulário de filtro -->
<div class="row">
    <div class="col-12" id="areaFiltro">
        <form id="frmIndexlanc" asp-route="ListaLancamentos" method="get" class="sidebar-form">
            <input type="hidden" name="idConta" value="@ViewBag.idConta" />

            <div class="row">
                <div class="col-2">
                    <div class="form-group">
                        <label>Data Inicial</label>
                        <input class="form-control datetime" type="text" name="DataInicial"
                               value="@ViewBag.DataInicial" data-mask="00/00/0000" />
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-group">
                        <label>Data Final</label>
                        <input class="form-control datetime" type="text" name="DataFinal"
                               value="@ViewBag.DataFinal" data-mask="00/00/0000" />
                    </div>
                </div>
                <div class="col-xs-1 align-items-center">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-outline-secondary" title="Filtrar">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tabela de resultados -->
<div id="divGridResultado">
    <table class="table table-hover">
        <thead class="table thead-dark">
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Valor</th>
                <th>Tipo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List)
            {
                var sentido = item.Tipo == ETipoContaLancacmento.Debito
                ? "bg-danger disabled color-palette"
                : "bg-success disabled color-palette";

                <tr>
                    <td>@Html.DisplayFor(modelItem => item.DataHora)</td>
                    <td>@Html.DisplayFor(modelItem => item.DescricaoLancamento)</td>
                    <td>@Html.Raw(item.Valor.ToString("C"))</td>
                    <td class="@sentido">@Html.DisplayFor(modelItem => item.Tipo)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginação -->
    <nav>
        <ul class="pagination justify-content-center">
            @{
                int maxPagesToShow = 10;
                int totalPages = (int)Model.TotalPages;
                int pageIndex = (int)Model.PageIndex;

                int half = maxPagesToShow / 2;
                int startPage = Math.Max(1, pageIndex - half);
                int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                if (endPage - startPage + 1 < maxPagesToShow)
                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);

                // Botão "Anterior"
                if (pageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route="ListaLancamentos"
                           asp-route-page="@(pageIndex - 1)"
                           asp-route-ps="@Model.PageSize"
                           asp-route-DataInicial="@ViewBag.DataInicial"
                           asp-route-DataFinal="@ViewBag.DataFinal"
                           asp-route-idConta="@ViewBag.idConta">Anterior</a>
                    </li>
                }

                // Primeira página + "..."
                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route="ListaLancamentos"
                           asp-route-page="1"
                           asp-route-ps="@Model.PageSize"
                           asp-route-DataInicial="@ViewBag.DataInicial"
                           asp-route-DataFinal="@ViewBag.DataFinal"
                           asp-route-idConta="@ViewBag.idConta">1</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Loop de páginas visíveis
                for (int i = startPage; i <= endPage; i++)
                {
                    if (i == pageIndex)
                    {
                        <li class="page-item active"><span class="page-link">@i</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-route="ListaLancamentos"
                               asp-route-page="@i"
                               asp-route-ps="@Model.PageSize"
                               asp-route-DataInicial="@ViewBag.DataInicial"
                               asp-route-DataFinal="@ViewBag.DataFinal"
                               asp-route-idConta="@ViewBag.idConta">@i</a>
                        </li>
                    }
                }

                // Última página + "..."
                if (endPage < totalPages)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item">
                        <a class="page-link"
                           asp-route="ListaLancamentos"
                           asp-route-page="@totalPages"
                           asp-route-ps="@Model.PageSize"
                           asp-route-DataInicial="@ViewBag.DataInicial"
                           asp-route-DataFinal="@ViewBag.DataFinal"
                           asp-route-idConta="@ViewBag.idConta">@totalPages</a>
                    </li>
                }

                // Botão "Próximo"
                if (pageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route="ListaLancamentos"
                           asp-route-page="@(pageIndex + 1)"
                           asp-route-ps="@Model.PageSize"
                           asp-route-DataInicial="@ViewBag.DataInicial"
                           asp-route-DataFinal="@ViewBag.DataFinal"
                           asp-route-idConta="@ViewBag.idConta">Próximo</a>
                    </li>
                }
            }
        </ul>
    </nav>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/local/Financeiro/planoConta.js"></script>
}
