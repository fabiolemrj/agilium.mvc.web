@model agilum.mvc.web.ViewModels.Estoque.FiltroEstoquePosicao

@{
    ViewData["Title"] = "Relatório de Posição de Estoque";
}

<h5>@ViewData["Title"]</h5>
<hr />

<section class="barra-de-menu-principal">
    <div class="barra-de-botoes-menu-principal">
        <a href="javascript:history.go(-1)" title="Voltar"><span class="fas fa-reply sns-tool-action"></span></a>
        <a href="#" title="Precisa de Ajuda?"><span class="fa fa-question sns-tool-action"></span></a>
    </div>

    <div class="barra-de-posicao-atual" id="breadcrumb">
        <a asp-action="Index" asp-controller="Home">Início</a> / Relatório Posição Estoque
    </div>
</section>

<br />

<div class="row mb-3" id="areaFiltro">
    <div class="col-md-3">
        <label for="IdEstoque">Estoque</label>
        <select id="IdEstoque" class="form-control">
            <option value="">Todos</option>
            @foreach (var est in Model.Estoques)
            {
                <option value="@est.Id">@est.Descricao</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label>&nbsp;</label>
        <input type="text" id="searchBox" class="form-control" placeholder="Pesquisar produto..." />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button id="btnFiltrar" class="btn btn-outline-secondary"><i class="fa fa-search"></i> Filtrar</button>
    </div>
</div>

<div id="overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.3);z-index:9999;">
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:white;">
        Carregando...
    </div>
</div>

<div id="tabelaContainer">
    @await Html.PartialAsync("_TabelaEstoque", Model.Lista)
</div>

<div id="pagination" class="mt-3"></div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function on() { $("#overlay").show(); }
    function off() { $("#overlay").hide(); }

    let dadosFiltrados = [];
    let rowsPerPage = 10;
    let currentPage = 1;


    function atualizarTabela() {
        on(); // mostra overlay

        // captura o id do estoque selecionado
        const idEstoque = $("#IdEstoque").val();

        // monta a URL com query string
        const url = '@Url.Action("RelatorioPosicaoEstoque", "Estoque")' + '?idEstoque=' + encodeURIComponent(idEstoque);

        $.ajax({
            type: "GET",
            url: url, // usa query string
            success: function (response) {
                // substitui tabela
                $("#tabelaContainer").html($(response).find("#tabelaContainer").html());

                // joga dados para objeto em memória
                dadosFiltrados = [];
                $("#tabelaEstoque tbody tr").each(function () {
                    dadosFiltrados.push({
                        CdProduto: $(this).find("td:nth-child(1)").text(),
                        NMProduto: $(this).find("td:nth-child(2)").text(),
                        NmGrupo: $(this).find("td:nth-child(3)").text(),
                        Quantidade: parseFloat($(this).find("td:nth-child(4)").text().replace(/,/g, '')) || 0,
                        VlCustoMedio: parseFloat($(this).find("td:nth-child(5)").text().replace(/,/g, '')) || 0,
                        VlFinanc: parseFloat($(this).find("td:nth-child(6)").text().replace(/,/g, '')) || 0,
                        NuQtdMin: parseFloat($(this).find("td:nth-child(7)").text().replace(/,/g, '')) || 0,
                        Situacao: $(this).find("td:nth-child(8) span").hasClass("text-danger") ? 2 : 1
                    });
                });

                aplicarFiltros(); // aplica busca e paginação
            },
            error: function () {
                alert("Erro ao carregar os dados.");
            },
            complete: function () { off(); } // oculta overlay
        });
    }


// Evento select de estoque
$("#IdEstoque").on("change", atualizarTabela);

// Evento botão filtrar
$("#btnFiltrar").on("click", atualizarTabela);


    function aplicarFiltros() {
        const busca = $("#searchBox").val().toLowerCase();
        const $tbody = $("#tabelaEstoque tbody");
        $tbody.empty();

        const filtrados = dadosFiltrados.filter(item => {
            return item.NMProduto.toLowerCase().includes(busca) ||
                item.CdProduto.toLowerCase().includes(busca);
        });

        const inicio = (currentPage - 1) * rowsPerPage;
        const fim = inicio + rowsPerPage;

        filtrados.slice(inicio, fim).forEach(item => {
            const classe = item.Situacao === 2 ? "text-danger" : "text-success";
            const classificacao = item.Situacao === 2 ? "Abaixo do mínimo" : "Normal";

            $tbody.append(`
                    <tr>
                        <td>${item.CdProduto}</td>
                        <td>${item.NMProduto}</td>
                        <td>${item.NmGrupo}</td>
                        <td>${item.Quantidade.toLocaleString()}</td>
                        <td>${item.VlCustoMedio.toLocaleString()}</td>
                        <td>${item.VlFinanc.toLocaleString()}</td>
                        <td>${item.NuQtdMin.toLocaleString()}</td>
                        <td><span class="${classe}">${classificacao}</span></td>
                    </tr>
                `);
        });

        renderizarPaginacao(filtrados.length);
    }

    function renderizarPaginacao(totalItems) {
        const totalPaginas = Math.ceil(totalItems / rowsPerPage) || 1;
        const $pagination = $("#pagination");
        $pagination.empty();

        const $wrapper = $("<div class='d-flex justify-content-center flex-wrap gap-1'></div>");
        $pagination.append($wrapper);

        if (currentPage > 1) {
            $("<button class='btn btn-sm btn-outline-primary'>Primeiro</button>").click(() => { currentPage = 1; aplicarFiltros(); }).appendTo($wrapper);
            $("<button class='btn btn-sm btn-outline-primary'>Anterior</button>").click(() => { currentPage--; aplicarFiltros(); }).appendTo($wrapper);
        }

        let maxVisible = 10;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalPaginas, startPage + maxVisible - 1);

        for (let i = startPage; i <= endPage; i++) {
            $("<button>")
                .text(i)
                .addClass("btn btn-sm " + (i === currentPage ? "btn-primary" : "btn-outline-primary"))
                .click(() => { currentPage = i; aplicarFiltros(); })
                .appendTo($wrapper);
        }

        if (currentPage < totalPaginas) {
            $("<button class='btn btn-sm btn-outline-primary'>Próximo</button>").click(() => { currentPage++; aplicarFiltros(); }).appendTo($wrapper);
            $("<button class='btn btn-sm btn-outline-primary'>Último</button>").click(() => { currentPage = totalPaginas; aplicarFiltros(); }).appendTo($wrapper);
        }
    }

    // Eventos
    $("#btnFiltrar").click(atualizarTabela);
    $("#searchBox").on("keyup", aplicarFiltros);
    $("#IdEstoque").on("change", atualizarTabela);

    // Inicializa
    $(document).ready(atualizarTabela);
</script>
