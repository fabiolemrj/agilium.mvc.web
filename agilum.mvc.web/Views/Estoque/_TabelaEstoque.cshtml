@model List<agilum.mvc.web.ViewModels.Estoque.EstoquePosicaoReport>

<table class="table table-hover" id="tabelaEstoque">
    <thead class="table thead-dark">
        <tr>
            <th>Código</th>
            <th>Produto</th>
            <th>Grupo Produto</th>
            <th>Total Estoque</th>
            <th>Custo Médio</th>
            <th>Valor Financ.</th>
            <th>Quant. Mínima</th>
            <th>Situação</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var acimaQuantMinima = item.Quantidade >= item.NuQtdMin;
            var classificacao = !acimaQuantMinima ? "Abaixo do mínimo" : "Normal";
            var classe = !acimaQuantMinima ? "text-danger" : "text-success";

            <tr>
                <td>@Html.Raw(item.CdProduto)</td>
                <td>@Html.Raw(item.NMProduto)</td>
                <td>@Html.Raw(item.NmGrupo)</td>
                <td>@Html.Raw(item.Quantidade.ToString("N"))</td>
                <td>@Html.Raw(item.VlCustoMedio.ToString("N"))</td>
                <td>@Html.Raw(item.VlFinanc.ToString("N"))</td>
                <td>@Html.Raw(item.NuQtdMin.ToString("N"))</td>
                <td><span class="@classe">@Html.Raw(classificacao)</span></td>
            </tr>
        }
    </tbody>
</table>
