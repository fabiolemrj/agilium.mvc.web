@using agilum.mvc.web.ViewModels.Conta
@model agilum.mvc.web.ViewModels.PagedViewModel<ContaReceberViewModelIndex>
@using agilum.mvc.web.Extensions

@{
    ViewData["Title"] = "Contas a Receber";
}
<h5>@ViewData["Title"]</h5>
<hr />
<section class="barra-de-menu-principal">
    <div class="barra-de-botoes-menu-principal">
        <a asp-action="CreateContaReceber" onclick="on()" title="Cadastrar Novo Registro"><span class="fa fa-plus-square sns-tool-action" id="btnNovoCadastro"></span></a>
        <a href="#" title="Precisa de Ajuda?" id="btnAjuda"><span class="fa fa-question sns-tool-action"></span></a>

    </div>

    <article>
        <div class="barra-de-posicao-atual" id="breadcrumb">
            <a asp-action="Index" asp-controller="Home"> Início</a> /
            <a href="#"><i class="fa fa-dashboard"></i> Contas a Receber </a>
        </div>
    </article>
</section>
<br />
<div class="row">
    <div class="col-12" id="areaFiltro">
        <form asp-action="IndexContaReceber" class="sidebar-form" method="get">
            <input type="hidden" asp-for="PageSize" id="PageSize" />
            <input type="hidden" asp-for="PageIndex " id="PageIndex" />
            <div class="row">
                <div class="col-2">
                    <div class="form-group">
                        <label id="lbDataInicial">Descrição</label>
                        <input value="@ViewBag.Pesquisa" class="form-control" title="Pesquisar por descrição" placeholder="Pesquisar por descrição..." id="q" name="q" />
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-group">
                        <label id="lbFornecedor">Cliente</label>
                        <input value="@ViewBag.Fornecedor" class="form-control" title="Pesquisar por Nome Cliente" placeholder="Pesquisar por fornecedor..." id="fornecedor" name="fornecedor" />
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-group">
                        <label id="lbDataInicial">Dt Inicio Vencimento</label>
                        <input class="form-control datetime" type="text" id="DataInicial" name="DataInicial" value="@ViewBag.DataInicial" data-mask="00/00/0000" />
                        <div class="invalid-feedback">
                            Campo deve ser fornecido.
                        </div>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-group">
                        <label id="lbDataFinal">Dt Fim Vencimento</label>
                        <input class="form-control datetime" type="text" id="DataFinal" name="DataFinal" value="@ViewBag.DataFinal" data-mask="00/00/0000" />
                        <div class="invalid-feedback">
                            Campo deve ser fornecido.
                        </div>
                    </div>
                </div>
                <!-- Select Tipo Lançamento abaixo do Data Final -->
                <div class="form-group col-2">
                    <label id="lbTipoLancamento">Situação</label>
                    <select class="form-control" id="situacao" name="situacao">
                        <option value="">-- Selecione --</option>
                        @if (ViewBag.Situacao == "1")
                        {
                            <option value="1" selected>Prevista</option>
                            <option value="2">Consolidada</option>
                        }
                        else if (ViewBag.Situacao == "2")
                        {
                            <option value="1">Prevista</option>
                            <option value="2" selected>Consolidada</option>
                        }
                        else
                        {
                            <option value="1">Prevista</option>
                            <option value="2">Consolidada</option>
                        }
                    </select>
                </div>
                <div class="align-items-center">
                    <div>
                        <div>
                            <label id="lbbotao">&nbsp</label>
                            <button type="submit" class="btn btn-info btn-flat w-100" title="Pesquisar">
                                <i class="fa fa-search"></i> Pesquisar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn" id="btnSendForm" type="submit" style="visibility:hidden"></button>

        </form>
    </div>
</div>
<div id="divGridResultado">
    <table class="table table-hover">
        <thead class="table thead-dark">
            <tr>
                <th>
                    Data Vencimento
                </th>
                <th>
                    Data Pagamento
                </th>
                <th>
                    Conta
                </th>
                <th>
                    Descrição
                </th>
                <th>
                    Categoria
                </th>
                <th>
                    Cliente
                </th>
                <th>
                    Situação
                </th>
                <th>
                    Valor
                </th>
                <th>
                    Descontos
                </th>
                <th>
                    Acréscimos
                </th>
                <th>
                    Total
                </th>
                <th>
                    Tipo Conta
                </th>
                <th>
                    Parcela
                </th>
                <th class=""></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.List)
            {
                var situacao = "Prevista";
                var classeSituacao = item.Situacao == 1 ? "" : "bg-success color-palette";

                if (item.DataVencimento == DateTime.Now && item.Situacao == 1)
                    classeSituacao = "bg-warning color-palette";
                else if (item.DataVencimento < DateTime.Now && item.Situacao == 1)
                    classeSituacao = "bg-danger color-palette";

                if (item.Situacao == 2)
                    situacao = "Consolidada";

                var valorConta = item.ValorConta.HasValue ? item.ValorConta.Value : 0;
                var valorDesconto = item.ValorDesconto.HasValue ? item.ValorDesconto.Value : 0;
                var valorAcrescimo = item.ValorAcrescimo.HasValue ? item.ValorAcrescimo.Value : 0;
                var valorTotal = valorConta - valorDesconto + valorAcrescimo;
                var dtPagamento = item.DataPagamento.HasValue ? item.DataPagamento.Value.ToString("dd/MM/yyyy") : "";
                var dtVencimento = item.DataVencimento.HasValue ? item.DataVencimento.Value.ToString("dd/MM/yyyy") : "";
                var dtCadastro = item.DatCadastro.HasValue ? item.DatCadastro.Value.ToString("dd/MM/yyyy") : "";
                <tr>
                    <td>
                        @Html.Raw(dtVencimento)
                    </td>
                    <td>
                        @Html.Raw(dtPagamento)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Conta)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CategoriaFinanceira)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cliente)
                    </td>
                    <td class="@classeSituacao">
                        @Html.Raw(situacao)
                    </td>
                    <td>
                        @Html.Raw(valorConta.ToString("C"))
                    </td>
                    <td>
                        @Html.Raw(valorDesconto.ToString("C"))
                    </td>
                    <td>
                        @Html.Raw(valorAcrescimo.ToString("C"))
                    </td>
                    <td>
                        @Html.Raw(valorTotal.ToString("C"))
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TipoConta)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ParcelaInicial)
                    </td>
                    @if (item.Situacao == 2)
                    {
                        <td class="acao-botoes text-right">
                            <a class="btn btn-danger" asp-action="DesConsolidarContaReceberPorId" asp-route-id="@item.Id" title="Desconsolidar"><i class="fas fa-check-circle"></i></a>
                        </td>
                    }
                    else
                    {
                        <td class="acao-botoes text-right">

                            <a class="btn btn-success" asp-action="ConsolidarContaReceberPorId" asp-route-id="@item.Id" title="Consolidar"><i class="fas fa-check-circle"></i></a>
                            <a class="btn btn-warning" asp-action="EditContaReceber" asp-route-id="@item.Id" title="Editar"><spam class="fa fa-pencil-alt"></spam></a>
                            <a class="btn btn-danger" asp-action="DeleteContaReceber" asp-route-id="@item.Id" title="Apagar"><spam class="fa fa-trash"></spam></a>
                        </td>
                    }

                </tr>
            }
        </tbody>
    </table>
    <nav>
        <ul class="pagination justify-content-center">
            @{
                int maxPagesToShow = 10;
                int totalPages = (int)Model.TotalPages;
                int pageIndex = (int)Model.PageIndex;

                int half = maxPagesToShow / 2;
                int startPage = Math.Max(1, pageIndex - half);
                int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                // Corrige quando o range não completa 5 páginas
                if (endPage - startPage + 1 < maxPagesToShow)
                {
                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                }

                // Botão "Anterior"
                if (pageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@(pageIndex - 1)" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-DataInicial="@ViewBag.DataInicial" asp-route-DataFinal="@ViewBag.DataFinal" asp-route-situacao="@ViewBag.Situacao" asp-route-fornecedor="@ViewBag.Fornecedor">Anterior</a>
                    </li>
                }

                // Primeira página + "..."
                if (startPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="1" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-DataInicial="@ViewBag.DataInicial" asp-route-DataFinal="@ViewBag.DataFinal" asp-route-situacao="@ViewBag.Situacao" asp-route-fornecedor="@ViewBag.Fornecedor">1</a></li>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                // Loop limitado
                for (int i = startPage; i <= endPage; i++)
                {
                    if (i == pageIndex)
                    {
                        <li class="page-item active"><span class="page-link">@i</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@i" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-DataInicial="@ViewBag.DataInicial" asp-route-DataFinal="@ViewBag.DataFinal" asp-route-situacao="@ViewBag.Situacao" asp-route-fornecedor="@ViewBag.Fornecedor">@i</a></li>
                    }
                }

                // Última página + "..."
                if (endPage < totalPages)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item"><a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@totalPages" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-DataInicial="@ViewBag.DataInicial" asp-route-DataFinal="@ViewBag.DataFinal" asp-route-situacao="@ViewBag.Situacao" asp-route-fornecedor="@ViewBag.Fornecedor">@totalPages</a></li>
                }

                // Botão "Próximo"
                if (pageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-controller="@Model.ReferenceController" asp-action="@Model.ReferenceAction" asp-route-page="@(pageIndex + 1)" asp-route-ps="@Model.PageSize" asp-route-q="@Model.Query" asp-route-DataInicial="@ViewBag.DataInicial" asp-route-DataFinal="@ViewBag.DataFinal" asp-route-situacao="@ViewBag.Situacao" asp-route-fornecedor="@ViewBag.Fornecedor">Próximo</a>
                    </li>
                }
            }
        </ul>
    </nav>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/local/Financeiro/contaReceber.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>

}