@model agilum.mvc.web.ViewModels.Cliente.ClienteViewModel

<div class="row">
    <input type="hidden" asp-for="EnderecoEntrega.Id" />
        <div class="col-2">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Cep" class="control-label" id="labelCepEntrega"></label>
                <input asp-for="EnderecoEntrega.Cep" class="form-control cep padrao" />
                <span asp-validation-for="EnderecoEntrega.Cep" class="text-danger"></span>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Logradouro" class="control-label" id="labelLogradouroEntrega"></label>
                <input asp-for="EnderecoEntrega.Logradouro" class="form-control Logradouro padrao" />
                <span asp-validation-for="EnderecoEntrega.Logradouro" class="text-danger"></span>
            </div>
        </div>

        <div class="col-2">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Numero" class="control-label" id="labelNumeroEntrega"></label>
                <input asp-for="EnderecoEntrega.Numero" class="form-control padrao" />
                <span asp-validation-for="EnderecoEntrega.Numero" class="text-danger"></span>
            </div>
        </div>

        <div class="col-3">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Complemento" class="control-label" id="labelComplementoEntrega"></label>
                <input asp-for="EnderecoEntrega.Complemento" class="form-control padrao" />
                <span asp-validation-for="EnderecoEntrega.Complemento" class="text-danger"></span>
            </div>
        </div>
 
        <div class="col-2">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Bairro" class="control-label" id="labelBairroEntrega"></label>
                <input asp-for="EnderecoEntrega.Bairro" class="form-control Bairro padrao" />
                <span asp-validation-for="EnderecoEntrega.Bairro" class="text-danger"></span>
            </div>
        </div>

        <div class="col-2">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Cidade" class="control-label" id="labelCidadeEntrega"></label>
                <input asp-for="EnderecoEntrega.Cidade" class="form-control Cidade padrao" />
                <span asp-validation-for="EnderecoEntrega.Cidade" class="text-danger"></span>
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.Uf" class="control-label" id="labelUfEntrega"></label>
                <select asp-for="EnderecoEntrega.Uf"
                        asp-items="ViewBag.estados"
                        class="form-control Uf padrao"></select>
                <span asp-validation-for="EnderecoEntrega.Uf" class="text-danger"></span>
            </div>
        </div>


        <div class="col-3">
            <div class="form-group">
                    <label asp-for="EnderecoEntrega.PontoReferencia" class="control-label" id="labelPontoRefEntrega"></label>
                <input asp-for="EnderecoEntrega.PontoReferencia" class="form-control" />
                <span asp-validation-for="EnderecoEntrega.PontoReferencia" class="text-danger"></span>
            </div>
        </div>
    
</div>
