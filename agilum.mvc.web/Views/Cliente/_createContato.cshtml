@using agilium.api.business.Enums
@model agilum.mvc.web.ViewModels.Cliente.ClienteContatoViewModel

@{
    Layout = null;
    var inclusao = ViewBag.operacao == "I";
    var operacao = "Contato Cliente";
    ViewData["Title"] = operacao;
}

<div class="modal-header">
    <h5 class="modal-title">@ViewData["Title"] — @ViewData["nome"]</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span aria-hidden="true">&times;</span><span class="sr-only">Fechar</span>
    </button>
</div>
<div class="modal-body">
    <form asp-action="@ViewBag.acao" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="frmCreateContatoCliente">
        <vc:Summary></vc:Summary>
        <input type="hidden" asp-for="IDCONTATO" />
        <input type="hidden" asp-for="IDCLIENTE" />

        <div class="row">
            <div class="col-md-4">
                <label asp-for="Contato.TPCONTATO" class="control-label"></label>
                <select asp-for="Contato.TPCONTATO" class="form-control" asp-items="Html.GetEnumSelectList<ETipoContato>()">
                </select>
                <span asp-validation-for="Contato.TPCONTATO" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Contato.DESCR1" class="control-label"></label>
                    <input asp-for="Contato.DESCR1" class="form-control" />
                    <span asp-validation-for="Contato.DESCR1" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Contato.DESCR2" class="control-label"></label>
                    <input asp-for="Contato.DESCR2" class="form-control" />
                    <span asp-validation-for="Contato.DESCR2" class="text-danger"></span>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer justify-content-between">
    <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
    <button type="button" class="btn btn-primary" id="btnSalvarContato">Salvar</button>
</div>

<script>
    $(function () {
        $('#btnSalvarContato').on('click', function () {
            $('#frmCreateContatoCliente').submit();
        });
    });
</script>
