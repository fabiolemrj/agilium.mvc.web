@using System.Security.Claims
@using agilium.api.business.Models

@{
    var nomeUsuario = User?.FindFirst(ClaimTypes.GivenName)?.Value 
                      ?? User?.FindFirst(ClaimTypes.Name)?.Value 
                      ?? User?.Identity?.Name 
                      ?? "";   
}

<div class="tituloEmpresaBarra">
    <i class="fas fa-building mr-2 empresa-icone"></i>
    <div class="empresa-nome-wrapper">
        <span class="empresa-nome-label">Empresa</span>
        <label class="__nomeEmpresa" id="idselec-txt" title="Empresa selecionada"></label>
    </div>
</div>



<ul class="navbar-nav ml-auto">
    @if (User != null && User.Identity.IsAuthenticated)
    {
        <li class="nav-item dropdown user-menu">
            <a class="nav-link user-trigger" data-toggle="dropdown" href="#" title="Opções do usuário">
                <span class="user-avatar">@nomeUsuario?.Substring(0, 1).ToUpper()</span>
                <span class="user-name">@nomeUsuario</span>
                <i class="fas fa-chevron-down user-arrow"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right user-dropdown">
                <!-- Cabeçalho do dropdown -->
                <div class="user-dropdown-header">
                    <span class="user-avatar-lg">@nomeUsuario?.Substring(0, 1).ToUpper()</span>
                    <div>
                        <span class="user-dropdown-name">@nomeUsuario</span>
                        <span class="user-dropdown-email">@User?.FindFirst(ClaimTypes.Email)?.Value</span>
                    </div>
                </div>

                <div class="dropdown-divider"></div>

                <a id="changePassword" class="dropdown-item user-dropdown-item" asp-controller="Identidade" asp-action="MudarSenha">
                    <i class="fas fa-key"></i>
                    <span>Mudar Senha</span>
                </a>

                <div class="dropdown-divider"></div>

                <a class="dropdown-item user-dropdown-item" asp-controller="Usuario" asp-action="Perfil">
                    <i class="fas fa-id-card"></i>
                    <span>Meu Perfil</span>
                </a>

                <div class="dropdown-divider"></div>

                <a id="logout" class="dropdown-item user-dropdown-item logout-item" href="#" onclick="on(); window.location.href='@Url.Action("Logout", "Identidade")'; return false;">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Sair</span>
                </a>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" asp-controller="Identidade" asp-action="Login">Login</a>
        </li>
    }


    <!-- Notifications Dropdown Menu -->

    <li class="nav-item">
        <a class="nav-link" data-widget="fullscreen" href="#" role="button" >
            <i class="fas fa-expand-arrows-alt"></i>
        </a>
      
    </li>

</ul>

