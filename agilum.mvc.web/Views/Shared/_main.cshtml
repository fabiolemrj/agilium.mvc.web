    @RenderSection("Scripts", required: false)

    <script>

        var configuracaoApp = {
            ambiente: "@HostingEnvironment.EnvironmentName", // Ex: "Development"
            valorParaCliente: "@Configuration["MinhaSecao:ValorQueVaParaCliente"]",
            apiUrl: "@Url.Content("~/api/algumEndpoint")" // Exemplo de como gerar uma URL
        };
     
        function SetModal() {

            $(document).ready(function () {
                $(function () {
                    $.ajaxSetup({ cache: false });

                    $("a[data-modal]").on("click",
                        function (e) {
                            $('#myModalContent').load(this.href,
                                function () {
                                    $('#myModal').modal({
                                        keyboard: true
                                    },
                                        'show');
                                    bindForm(this);
                                });
                            return false;
                        });
                });
            });
        }

        function bindForm(dialog) {
            $('form', dialog).submit(function () {
                $.ajax({
                    url: this.action,
                    type: this.method,
                    data: $(this).serialize(),
                    success: function (result) {
                        if (result.success) {
                            $('#myModal').modal('hide');
                            if (result.url) {
                                $('#ContatoTarget').load(result.url); // Carrega o resultado HTML para a div demarcada
                            } else {
                                $('#ContatoTarget').html(result);
                            }


                            Swal.fire({
                                icon: 'success',
                                title: 'Sucesso',
                                text: 'Operação realizada com sucesso'
                            });
                        } else {
                            $('#myModalContent').html(result);
                            bindForm(dialog);
                        }
                    }
                });

                SetModal();
                return false;
            });
        }

        $(document).ready(function () {

            //Renderiza a mensagem que retorna da controller
            if ("@ViewBag.TipoMensagem" != '') {
                ModalMensagem("@ViewBag.TipoMensagem", "@Html.Raw(ViewBag.Mensagem)");
            }
            else if ("@TempData["TipoMensagem"]" != '') {
                ModalMensagem("@TempData["TipoMensagem"]", "@TempData["Mensagem"]");
            }

        });

        function on() {
            document.getElementById("overlay").style.display = "block";
        }

        function off() {
            document.getElementById("overlay").style.display = "none";
        }

        function ModalMensagem(tipoModal, mensagemModal) {
            var _tipoModal;

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "showDuration": "1000",
                "hideDuration": "1000",
                "timeOut": "10000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            }

            switch (tipoModal) {

                case "warning":
                    toastr.warning(mensagemModal)
                    break;
                case "danger":
                    toastr.error(mensagemModal)
                    break;
                case "info":
                    toastr.info(mensagemModal)
                    break;
                case "success":
                    toastr.success(mensagemModal)
                    break;

                default:
                    toastr.success(mensagemModal)
                    break;
            }
        }

        $('#btnYes').click(function () {

            // handle form processing here

            alert('submit form');
            $('form').submit();

        });

        $(".indisponivel").click(function () {
            ModalMensagem("danger", "Recurso Indisponível para versão Web");
        });
        $(document).ready(function () {
            ObterEmpresaSelecionado();
            ObterVersaoSistema();
        });

        function ObterEmpresaSelecionado(){
            const ambiente= "@HostingEnvironment.EnvironmentName"; // Ex: "Development";
            let _url = "";
            if (ambiente == "Development")
                _url = "/empresa/ObterEmpresaSelecionada";
            else
                _url = "/mvc/empresa/ObterEmpresaSelecionada"
            $.ajax({
                type: 'get',
                url: _url,
                success: function (resultado) {
                    if (resultado == null ) {
                        toastr.error("Erro")
                        return;
                    }
                    const idEmpresa = JSON.parse(JSON.stringify(resultado));
                    if(idEmpresa)
                        $('#idselec-txt').text(idEmpresa);
                    else
                        $('#idselec-txt').text("Selecione uma empresa");
                },
                error: function (result) {
                    $('#idselec-txt').text('Selecione uma empresa');
                }
            });
        }

        function ObterVersaoSistema(){
            const ambiente = "@HostingEnvironment.EnvironmentName"; // Ex: "Development";
            let _url = "";
            if (ambiente == "Development")
                _url = '/ObterVersaoSistema';
            else
                _url = '/mvc/ObterVersaoSistema'

            $.ajax({
                type:'get',
                url: _url,
                success:function(resultado){
                    if(resultado)
                    {
                        const versao = JSON.parse(JSON.stringify(resultado));
                        $('#versao_sistema').text(versao.versao);
                    }
                       
                }
            });
        }


    </script>

    <script>
        $(document).ready(function () {

            if (("@ViewBag.TipoMensagem" != '') || ("@TempData["TipoMensagem"]" != '')) 
            { 
                off();
            }

            // 1️⃣ Links de menu e links gerais que levam para outra página
            $(document).on("click", "a.nav-link, a[data-link], a.menu-link, a.btn-warning, a.btn-danger, a.btn-default", function (e) {
                const href = $(this).attr("href");

                // Se for vazio, # ou apenas âncora interna, não faz overlay
                if (!href || href === "#" || href.startsWith("#")) {
                    return; // deixa o Bootstrap tab funcionar normalmente
                }

                // Se for navegação real → mostra overlay e redireciona
                e.preventDefault();
                on();
                window.location.href = href;
            });

            // 2️⃣ Links que abrem modais via AJAX
            $(document).on("click", "a[data-modal]", function (e) {
                e.preventDefault();
                on();
                $('#myModalContent').load(this.href, function () {
                    $('#myModal').modal({ keyboard: true }, 'show');
                    bindForm(this);
                    off(); // opcional: remove overlay após o modal carregar
                });
            });

            // 3️⃣ Formulários - qualquer submit
            $(document).on("submit", "form", function () {
                on();
            });

            // Esconde overlay quando a nova página terminar de carregar
            $(window).on("load", function () {
                off();
            });

            // 4️⃣ Links ou botões específicos com classe load__tela
            $(document).on("click", ".load__tela", function () {
                on();
            });

            $(window).on("error", function () {
                off();
            });

            $(document).ajaxStart(function () {
                on();
            });

            $(document).ajaxStop(function () {
                off();
            });

            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                off(); // se houve erro, some com overlay
                toastr.error("Erro na requisição: " + thrownError);
            });

            // 6️⃣ Se modal for fechado manualmente → garantir off()
            $(document).on('hidden.bs.modal', '#myModal', function () {
                off();
            });

        });
    </script>


