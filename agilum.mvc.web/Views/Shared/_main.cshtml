@using Microsoft.AspNetCore.Identity
@using agilum.mvc.web.Data
@inject SignInManager<AppUserAgiliumIdentity> SignInManager
@inject UserManager<AppUserAgiliumIdentity> UserManager

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agilium Manager</title>

    <link rel="icon" type="image/x-icon" href="~/Images/logo_v3c_SIMBOLO.png" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />

    <!-- Icons e Plugins -->
    <link rel="stylesheet" href="~/dist/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/icheck-bootstrap/icheck-bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css" integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2" crossorigin="anonymous">

    <!-- CSS do site e AdminLTE -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/chart.js/Chart.css" />
    <link rel="stylesheet" href="~/css/toastr.css" />
    <link rel="stylesheet" href="~/dist/plugins/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/dist/plugins/daterangepicker/daterangepicker.css" />
    <link rel="stylesheet" href="~/dist/plugins/bootstrap-colorpicker/css/bootstrap-colorpicker.min.css" />

    <!-- DataTables + Select2 -->
    <link rel="stylesheet" href="~/dist/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/dist/plugins/select2-bootstrap4-theme/select2-bootstrap4.css" />

    @RenderSection("Head", required: false)
</head>

<body class="hold-transition sidebar-mini text-md accent-navy">
    <div id="overlay" style="display:none;">
        <div class="loader">
            <p class="mt-3 text-white font-weight-bold">Carregando...</p>
            <img id="imgLoader" src="~/Images/loading-gif-png-5.gif" alt="Aguarde o carregamento..." />
        </div>
    </div>

    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-light navbar-warning">
            <a class="brand-link text-lg-left"></a>
            <partial name="_LoginPartial" />
        </nav>

        <aside class="main-sidebar sidebar-light-navy elevation-4">
            <a class="brand-link navbar-warning" data-widget="pushmenu" href="#" role="button">
                <div class="logoAgilium">
                    <img src="~/Images/logo_v3c_SIMBOLO.png" alt="Logo" id="_logo_Agilium" class="brand-image img-circle elevation-3" style="opacity: .8" />
                    <span class="fonteLogoAgilium">AGILIUM MANAGER</span>
                </div>
            </a>

            <partial name="_AsideMenu" />
        </aside>

        <div class="content-wrapper">
            <div class="content-header"></div>
            <div class="conteudo content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>

        <partial name="_rodape" />
    </div>

    <!-- Modal global (usado para carregar partials via AJAX) -->
    <div id="myModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="myModalContent"></div>
        </div>
    </div>

    <!-- SCRIPTS: carregue bibliotecas uma vez -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- AdminLTE -->
    <script src="~/dist/js/adminlte.min.js"></script>

    <!-- Plugins -->
    <script src="~/dist/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <script src="~/dist/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/dist/plugins/daterangepicker/daterangepicker.js"></script>

    <!-- Jquery Mask (SOMENTE UMA VEZ) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <!-- Seus scripts -->t>
    <script src="~/js/site.js"></script>
    @* Seu script de site principal (se tiver) *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dknotus-tour.min.js"></script>

    @* =================== SCRIPTS CONSOLIDADOS E SEGUROS =================== *@
    <script>
        $(document).ready(function () {
            $('#btnVoltar').on('click', function (e) {
                e.preventDefault();
                history.back();
            });
        })

        // Configuração inicial
        var configuracaoApp = {
            ambiente: "@HostingEnvironment.EnvironmentName",
            valorParaCliente: "@Configuration["MinhaSecao:ValorQueVaParaCliente"]",
            apiUrl: "@Url.Content("~/api/algumEndpoint")"
        };

        // Overlay helpers
        function on() {
            document.getElementById("overlay").style.display = "block";
        }
        function off() {
            document.getElementById("overlay").style.display = "none";
        }

        // ----------------- MODAL CONTROL (único handler) -----------------
        function SetModal() {
            // remover binds antigos evita duplicação
            $(document).off("click", "a[data-modal]");

            $(document).on("click", "a[data-modal]", function (e) {
                e.preventDefault();

                var url = $(this).attr("href");
                if (!url) return;

                // evita abrir várias vezes (desabilita link enquanto carrega)
                var $link = $(this);
                if ($link.data("loading")) return;
                $link.data("loading", true);

                $('#myModalContent').html('<div class="p-4 text-center">Carregando...</div>');
                $('#myModal').modal('show');

                // carrega partial
                $('#myModalContent').load(url, function (response, status, xhr) {
                    // libera o link
                    $link.data("loading", false);

                    if (status === "error") {
                        $('#myModalContent').html('<div class="p-4 text-danger text-center">Erro ao carregar.</div>');
                        return;
                    }

                    // aplica binds somente dentro do conteúdo do modal
                    bindForm($('#myModalContent'));
                });
            });
        }

        // ----------------- BIND DO FORM DO MODAL (ISOLADO) -----------------
        function bindForm($dialog) {
            // $dialog pode ser selector string ou jQuery object
            var $root = $($dialog);

            // remove handlers antigos (evita múltiplos bindings)
            $root.find('form').off('submit');

            // aplica novo handler para cada form dentro do modal
            $root.find('form').on('submit', function (e) {
                e.preventDefault();
                var $form = $(this);

                // opcional: validação cliente (se tiver)
                // if (!$form.valid || !$form.valid()) return;

                // desabilita botão submit para evitar dupla submissão
                var $btn = $form.find('button[type="submit"], input[type="submit"]').prop('disabled', true);

                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method') || 'post',
                    data: $form.serialize(),
                    success: function (result) {
                        $btn.prop('disabled', false);
                        if (result && result.success) {
                            $('#myModal').modal('hide');
                            if (result.url) {
                                // atualiza área de contatos
                                $('#ContatoTarget').load(result.url);
                            } else {
                                // fallback: recarrega partial padrão que lista contatos (ajuste se necessário)
                                $('#ContatoTarget').load(window.location.href + ' #ContatoTarget > *');
                            }

                            Swal.fire({
                                icon: 'success',
                                title: 'Sucesso',
                                text: 'Operação realizada com sucesso'
                            });

                        } else {
                            // resultado é HTML de validação (partial) -> re-renderiza modal
                            $('#myModalContent').html(result);
                            // re-bind para o novo conteúdo
                            bindForm($('#myModalContent'));
                        }
                    },
                    error: function (xhr, status, err) {
                        $btn.prop('disabled', false);
                        Swal.fire({
                            icon: 'error',
                            title: 'Erro',
                            text: 'Erro ao processar a requisição.'
                        });
                    }
                });

                return false;
            });
        }

        // ----------------- LIMPAR AO FECHAR -----------------
        $(document).on('hidden.bs.modal', '#myModal', function () {
            // remove handlers e limpa html para evitar "event leakage"
            $(this).find('form').off('submit');
            $('#myModalContent').html('');
            off();
        });

        // ----------------- AJAX GLOBAL: evitar overlay para modal -----------------
        // Guarda a URL da última requisição enviada (via ajaxSend)
        window.lastAjaxUrl = null;

        $(document).ajaxSend(function (event, xhr, settings) {
            window.lastAjaxUrl = settings && settings.url ? settings.url : null;
        });

        $(document).ajaxStart(function () {
            // se última requisição for do tipo modal (contato/novo ou contato/editar), NÃO ligar overlay
            if (window.lastAjaxUrl && (window.lastAjaxUrl.indexOf('contato/editar') !== -1 || window.lastAjaxUrl.indexOf('contato/novo') !== -1)) {
                return;
            }
            on();
        });

        $(document).ajaxStop(function () {
            off();
        });

        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            off();
            toastr.error("Erro na requisição: " + (thrownError || jqxhr.statusText));
        });

        // ----------------- INICIALIZAÇÃO -----------------
        $(function () {
            SetModal();

            // Renderiza mensagens vindas da controller (se existirem)
        @* Quando ViewBag.TipoMensagem estiver preenchido *@
                    if ("@ViewBag.TipoMensagem" !== '') {
                ModalMensagem("@ViewBag.TipoMensagem", "@Html.Raw(ViewBag.Mensagem)");
            } else if ("@TempData["TipoMensagem"]" !== '') {
                ModalMensagem("@TempData["TipoMensagem"]", "@TempData["Mensagem"]");
            }

            // exemplo: inicializações que existiam
            ObterEmpresaSelecionado();
            ObterVersaoSistema();
        });

        // ----------------- UTIL: ModalMensagem, ObterEmpresaSelecionado, ObterVersaoSistema -----------------
        function ModalMensagem(tipoModal, mensagemModal) {
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "showDuration": "1000",
                "hideDuration": "1000",
                "timeOut": "10000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            switch (tipoModal) {
                case "warning": toastr.warning(mensagemModal); break;
                case "danger": toastr.error(mensagemModal); break;
                case "info": toastr.info(mensagemModal); break;
                case "success": toastr.success(mensagemModal); break;
                default: toastr.success(mensagemModal); break;
            }
        }

        function ObterEmpresaSelecionado() {
            var ambiente = "@HostingEnvironment.EnvironmentName";
            var _url = "/empresa/ObterEmpresaSelecionada";
            $.get(_url)
                .done(function (resultado) {
                    if (!resultado) {
                        $('#idselec-txt').text("Selecione uma empresa");
                        return;
                    }
                    $('#idselec-txt').text(resultado);
                })
                .fail(function () {
                    $('#idselec-txt').text("Selecione uma empresa");
                });
        }

        function ObterVersaoSistema() {
            var _url = '/ObterVersaoSistema';
            $.get(_url)
                .done(function (resultado) {
                    if (resultado && resultado.versao) {
                        $('#versao_sistema').text(resultado.versao);
                    }
                });
        }
    </script>
   
    @RenderSection("Scripts", required: false)
</body>
</html>
